# ==============================================================================
# Watchbloom Video Streaming Platform - Environment Configuration
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# ── APPLICATION & SECURITY ──
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-strong-random-secret-key-for-production-min-32-chars
JWT_SECRET=generate-a-strong-jwt-secret-key-for-token-signing
JWT_EXPIRATION_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5000,http://127.0.0.1,http://127.0.0.1:5000
MAX_CONTENT_LENGTH=262144000
REQUIRE_SIGNED_MEDIA=0

# ── GUNICORN PRODUCTION SERVER ──
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
LOG_LEVEL=info

# ── REDIS & CACHING ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=300

# ── CELERY ASYNCHRONOUS WORKERS ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=4

# ── POSTGRESQL PRIMARY (WRITES) ──
POSTGRES_DB=watchbloom
POSTGRES_USER=watchbloom_user
POSTGRES_PASSWORD=watchbloom_secure_password_replace_in_prod
POSTGRES_PORT=5432
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_password_replace_in_prod

# ── PGBOUNCER CONNECTION POOLING ──
PGBOUNCER_WRITE_PORT=6432
PGBOUNCER_READ_PORT=6433
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=10000
PGBOUNCER_DEFAULT_POOL_SIZE=50

# Internal application database connection strings (routed through PgBouncer)
DATABASE_URL=postgresql://watchbloom_user:watchbloom_secure_password_replace_in_prod@pgbouncer_write:6432/watchbloom
DATABASE_READ_URLS=postgresql://watchbloom_user:watchbloom_secure_password_replace_in_prod@pgbouncer_read:6433/watchbloom

# ── CLOUDFLARE R2 OBJECT STORAGE & CLOUDFLARE CDN ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=watchbloom-media
CDN_BASE_URL=

# ── OBSERVABILITY & MONITORING ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── COMPRESSION ──
ENABLE_BROTLI=1
ENABLE_MSGPACK=1
COMPRESSION_MIN_BYTES=512

